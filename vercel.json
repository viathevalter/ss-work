{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sso/(.*)", "destination": "/index.html" },
    { "source": "/ptss/(.*)", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
